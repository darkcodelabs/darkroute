{
  "name": "darkroute",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Android-first counter-surveillance PWA that alerts drivers to ALPR cameras.",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.15.0"
  },
  "scripts": {
    "dev": "pnpm run dev:pwa",
    "dev:pwa": "pnpm --filter @fwm/pwa dev",
    "build": "pnpm run build:pwa",
    "build:pwa": "pnpm --filter @fwm/pwa build",
    "test": "pnpm run test:unit",
    "test:unit": "pnpm -r --if-present test:unit && pnpm run test:scripts && pnpm run test:functions && pnpm run test:gateway",
    "test:e2e": "pnpm --filter @fwm/pwa test:e2e",
    "lint": "eslint . --max-warnings=0 && pnpm run check:design && pnpm run check:help && pnpm run check:records && pnpm run check:counties && pnpm run check:assets",
    "check:design": "node scripts/check-design-values.mjs",
    "typecheck": "pnpm -r --if-present typecheck && pnpm run typecheck:functions",
    "format": "prettier --write .",
    "check:help": "node scripts/check-help-citations.mjs",
    "ship": "node scripts/deploy.mjs",
    "ship:verify": "node scripts/deploy.mjs --verify",
    "preflight": "node scripts/preflight.mjs",
    "check:records": "node scripts/check-record-citations.mjs",
    "check:counties": "node scripts/build-county-index.mjs --check",
    "test:scripts": "node --test --test-concurrency=1 scripts/*.test.mjs",
    "check:assets": "node scripts/check-basemap-assets.mjs",
    "basemap:plan": "node scripts/build-basemap.mjs --plan",
    "basemap:build": "node scripts/build-basemap.mjs --build",
    "basemap:verify": "node scripts/build-basemap.mjs",
    "basemap:publish": "node scripts/publish-basemap.mjs",
    "basemap:verify-live": "node scripts/publish-basemap.mjs --verify-live",
    "typecheck:functions": "tsc --noEmit -p functions/tsconfig.json",
    "check:fits": "node scripts/check-text-fits.mjs",
    "check:back": "node scripts/check-back-affordance.mjs",
    "test:functions": "vitest run --config functions/vitest.config.ts",
    "check:links": "node scripts/check-public-links.mjs",
    "check:links:live": "node scripts/check-public-links.mjs --require-public-live",
    "verify:render": "pnpm --filter @fwm/pwa exec node scripts/verify-render.mjs",
    "verify:prod": "pnpm --filter @fwm/pwa exec node scripts/verify-render.mjs https://darkroute.ai"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3",
    "@aws-sdk/lib-storage": "3",
    "@cloudflare/workers-types": "5.20260901.1",
    "@mapbox/vector-tile": "3.0.0",
    "@playwright/test": "1.62.1",
    "@protomaps/basemaps": "5.7.2",
    "@types/sax": "^1.2.7",
    "eslint": "10.8.1",
    "pbf": "5.1.2",
    "prettier": "3.9.6",
    "sax": "^1.6.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11",
    "wrangler": "4.128.0"
  }
}
