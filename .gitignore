# Dependencies
node_modules/
vendor/
__pycache__/
.pytest_cache/
*.egg-info/

# Build
dist/
build/
out/
*.tgz
*.tar.gz

# Environment
.env
.env.*
!the environment template
# Deploy credentials. NOT covered by the two rules above - `.deploy.env` matches
# neither `.env` nor `.env.*` - so it was an untracked, unignored file holding a
# Cloudflare API token, one `git add -A` away from being committed.
.deploy.env

# Legacy or contributor-created Python virtual environments are never source.
# The current installer is Node-only, but a broad glob prevents an old 200 MB
# environment from being staged during migration or cleanup.
.venv*/

# IDE
.idea/
.vscode/*
!.vscode/settings.json
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Coverage
coverage/
.nyc_output/
htmlcov/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Runtime
*.pid
*.seed
*.pid.lock

# Compiled
*.js.map
*.d.ts
!src/**/*.d.ts

# Extracted design source (from ~/DarkRoute Design System 80s.zip). Reference only;
# the tokens that matter are already checked in as src/styles/tokens.css.
# Downloaded boundary files (Census place shapefile). Regenerated by
# scripts/places.mjs; 23 MB of somebody else's data does not belong in git.
.cache/

.design-src/
.design-src-v2/
.design-src-v3/
# The v1 redesign export, same convention as the three above: vendored
# designer output, read and never edited, so reformatting it to satisfy a
# linter cannot happen. The archive it came from is the source of truth.
.design-src-v1/

# NOT ignored: apps/pwa/public/basemap-assets/
#
# These were ignored on the reasoning that they are reproducible build output.
# The consequence was that NOTHING ran the vendor script -- not the build, not
# CI -- so the map only had labels and icons on the one machine where 1.8 MB
# happened to already sit in that directory. A fresh clone shipped a PWA that
# 404s every glyph range and both sprite sheets: no street names, no icons,
# which is exactly the offline failure self-hosting them was meant to fix.
#
# They are 27 files, about 1.8 MB, third-party, immutable and pinned to a commit.
# That makes them closer to a lockfile than to build output, and a build should
# not need the network to draw a label.

# Wrangler dev state and generated bundles. Committed once by accident:
# 14 files, including miniflare sqlite WAL and the compiled functions worker,
# which is a build output of `functions/` and was the entire eslint failure.
.wrangler/

# Scratch checkouts and probe scripts from audit agents. Never committed.
.audit-*
.*-check.mjs
.*-probe.mjs
.exp.mjs
.glass2.mjs

# Playwright output. Never committed - it is a build artifact and it
# carries screenshots of whatever the run happened to render.
test-results/
playwright-report/

# Curation-backend working output. 2.8 GB of dry-run payloads, generated tiles
# and pull ledgers - all reproducible from the scripts, none of it source.
the curation output directory
the curation output directory

# Agent worktrees. `.claude/worktrees/` holds throwaway git worktrees created to
# run work in isolation; they are checkouts of this same repository and must
# never be committed into it. They also have to be IGNORED rather than merely
# untracked: the public-seed builder refuses to build the curated public tree
# unless `git status --untracked-files=all` is completely empty, so an unignored
# scratch directory blocks the release outright.
.claude/worktrees/

# Throwaway probe scripts written into the tree by agents and headless checks.
# Three of these were committed by a `git add -A`, and they failed lint on the
# next run - which is how a scratch file becomes everybody's problem.
dr-audit-*.mjs
.perf-probe.mjs
.scroll-probe.mjs
.beacon-probe.mjs
