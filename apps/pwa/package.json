{
  "name": "@fwm/pwa",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "description": "DarkRoute PWA \u2014 one bundle, four surfaces: phone, watch-round, watch-square, dash.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build && node ../../scripts/check-security-headers.mjs --dist && node ../../scripts/check-basemap-assets.mjs --dist",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify:render": "node scripts/verify-render.mjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.14.0",
    "@mapbox/vector-tile": "^3.0.0",
    "@meshtastic/js": "2.6.0-0",
    "@protomaps/basemaps": "5.7.2",
    "@tanstack/react-query": "5.101.4",
    "idb": "8.0.3",
    "maplibre-gl": "5.6.1",
    "pbf": "^5.1.2",
    "pmtiles": "4.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "workbox-window": "7.4.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/geojson": "^7946.0.16",
    "@types/mapbox__vector-tile": "^2.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "10.5.4",
    "jsdom": "30.0.1",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11",
    "workbox-build": "7.4.1"
  }
}
